                "REG_E"
              ]
            },
            "annualPercentageYield": {
              "type": "number",
              "description": "Annual Percentage Yield",
              "x-fdx-csdf-account-categories": [
                "REG_E"
              ]
            },
            "interestYtd": {
              "type": "number",
              "description": "YTD Interest",
              "x-fdx-csdf-account-categories": [
                "REG_E"
              ]
            },
            "term": {
