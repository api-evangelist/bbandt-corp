          "description": "Owners of the account"
        }
      }
    },
    "AccountDescriptor": {
      "title": "Account Descriptor entity",
      "description": "This descriptor provides minimal information about the account for use in lightweight arrays",
      "type": "object",
      "x-fdx-csdf-account-categories": [
        "ANY"
      ],
      "properties": {
        "accountCategory": {
          "$ref": "#/$defs/AccountCategory",
          "description": "The category of account",
          "x-fdx-csdf-account-categories": [
            "ANY"
          ]
        },
        "accountId": {
          "description": "Long-term persistent identity of the account, though not an account number. This identity must be unique to the owning institution",
          "$ref": "#/$defs/Identifier",
          "x-fdx-csdf-account-categories": [
            "ANY"
          ]
        },
        "accountType": {
          "$ref": "#/$defs/AccountType",
          "description": "Account type",
          "x-fdx-csdf-account-categories": [
            "ANY"
          ]
        },
        "accountNumber": {
          "description": "Shows masked customer account number. To retrieve a tokenized account number and its corresponding routingTransitNumber for money movement transactions on a Checking or Savings (DDA) account, call the Truist Account Payment Networks API for this accountId",
          "type": "string",
          "x-fdx-csdf-account-categories": [
            "ANY"
          ]
        },
        "accountNumberDisplay": {
          "description": "Account display number for the end user's handle at the owning institution. This is to be displayed by the Interface Provider",
          "type": "string",
          "x-fdx-csdf-account-categories": [
            "ANY"
          ]
        },
        "productName": {
          "type": "string",
          "description": "Marketed product name for this account. Used in UIs to assist in account selection",
          "x-fdx-csdf-account-categories": [
            "ANY"
          ]
        },
        "nickname": {
          "description": "Name given by the user. Used in UIs to assist in account selection",
          "type": "string",
          "x-fdx-csdf-account-categories": [
            "ANY"
          ]
        },
        "status": {
          "$ref": "#/$defs/AccountStatus",
          "description": "Account status. Values are: OPEN, CLOSED",
          "x-fdx-csdf-account-categories": [
            "ANY"
          ]
        },
        "accountOpenDate": {
          "$ref": "#/$defs/DateString",
          "description": "Account opening date",
          "x-fdx-csdf-account-categories": [
            "ANY"
          ]
        },
        "currency": {
          "$ref": "#/$defs/Currency",
          "description": "Account currency",
          "x-fdx-csdf-account-categories": [
            "ANY"
          ]
        },
        "fiAttributes": {
          "type": "array",
          "description": "Array of Financial institution-specific attributes",
          "items": {
            "$ref": "#/$defs/FiAttribute"
          },
          "x-fdx-csdf-account-categories": [
            "ANY"
          ]
        }
      }
    },
    "AccountHolder": {
      "title": "Account Holder entity",
      "description": "Defines the account holder's relationship with an account.",
      "type": "object",
      "x-fdx-csdf-account-categories": [
        "ANY"
      ],
      "properties": {
        "relationship": {
          "$ref": "#/$defs/AccountHolderRelationship",
          "description": "Customer's relationship to the account",
          "x-fdx-csdf-account-categories": [
            "ANY"
          ]
        }
      }
    },
    "AccountHolderRelationship": {
      "title": "Account Holder Relationship",
      "description": "Types of relationships between accounts and holders",
      "type": "string",
      "x-fdx-csdf-account-categories": [
        "ANY"
      ],
      "enum": [
        "AUTHORIZED_USER",
        "BUSINESS",
        "POWER_OF_ATTORNEY",
        "PRIMARY",
        "PRIMARY_JOINT",
        "PRIMARY_JOINT_TENANTS",
        "SECONDARY",
        "TRUSTEE"
      ]
    },
    "AccountStatus": {
      "title": "Account Status",
      "description": "The status of an account",
      "type": "string",
      "x-fdx-csdf-account-categories": [
        "ANY"
      ],
      "enum": [
        "CLOSED",
        "OPEN"
      ]
    },
    "AccountType": {
      "title": "Account Type",
      "x-fdx-csdf-account-categories": [
        "ANY"
      ],
      "description": "The type of an account.\n  | Value | Description |\n  |-----|-----|\n  | BROKERAGEPRODUCT | Investment management offered by a licensed brokerage firm that places trades on behalf of the customer, utilizing any number of investment options |\n  | CD | A certificate of deposit (CD) is a product offered by banks and credit unions that provides an interest rate premium in exchange for the customer agreeing to leave a lump-sum deposit untouched for a predetermined period of time |\n  | CHECKING | A deposit account held at a financial institution that allows withdrawals and deposits |\n  | COMMERCIALLOAN | A preset borrowing limit that can be used at any time |\n  | CREDITCARD | Allows cardholders to borrow funds with which to pay for goods and services with merchants that accept cards for payment |\n  | IRA | An individual retirement account (IRA) is a tax-advantaged account that individuals use to save and invest for retirement |\n  | LINEOFCREDIT | A credit facility extended by a bank or other financial institution to a government, business or individual customer that enables the customer to draw on the facility when the customer needs funds |\n  | MORTGAGE | A type of loan you can use to buy or refinance a home |\n  | PERSONALLOAN | A type of debt that is not protected by a guarantor, or collateralized by a lien on specific assets of the borrower |\n  | SAVINGS | An interest-bearing deposit account held at a bank or other financial institution |\n  | TRUST | A type of financial account that is opened by an individual and managed by a designated trustee for the benefit of a third party in accordance with agreed-upon terms |",
      "type": "string",
      "enum": [
        "BROKERAGEPRODUCT",
        "CD",
        "CHECKING",
        "COMMERCIALLOAN",
        "CREDITCARD",
        "IRA",
        "LINEOFCREDIT",
        "MORTGAGE",
        "PERSONALLOAN",
        "SAVINGS",
        "TRUST"
      ]
    },
    "AccountWithDetails": {
      "title": "Account With Details entity",
      "description": "This provides an instance of an account with full details",
      "type": "object",
      "x-fdx-csdf-account-categories": [
        "ANY"
      ],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "depositAccount": {
              "$ref": "#/$defs/DepositAccount",
