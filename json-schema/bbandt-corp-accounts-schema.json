    "Holding": {
      "title": "Holding entity",
      "description": "A holding in an investment account",
      "type": "object",
      "properties": {
        "holdingId": {
          "type": "string",
          "description": "Currently the CUSIP id for the holding. May not be a unique value across the account's holdings"
        },
        "securityId": {
          "type": "string",
          "description": "Unique identifier of security"
        },
        "holdingName": {
          "type": "string",
          "description": "Holding name or security name"
